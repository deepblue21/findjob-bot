# Bu dosyayı .env olarak kopyalayıp kendi değerlerinle doldur:
#   cp .env.example .env
# Telegram > @BotFather > /newbot   -> TELEGRAM_BOT_TOKEN
# Telegram > @userinfobot           -> TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Opsiyonel dashboard korumasi. DASHBOARD_PASSWORD bos kalirsa kapali olur.
# Tailscale kullansan bile uzaktan erisim icin sifre eklemek onerilir.
DASHBOARD_USERNAME=jobbot
DASHBOARD_PASSWORD=
